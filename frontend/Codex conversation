    def _utc(value: datetime) -> datetime:
        return value.replace(tzinfo=timezone.utc) if value.tzinfo is None else value
    
    
    def _worker_status(row: ServiceHeartbeat | None, now: datetime) -> dict:
        if row is None or row.last_completed_at is None:
            return {"status": "unknown", "last_started_at": None, "last_completed_at": None, "error_code": None}
        completed = _utc(row.last_completed_at)
        age = max(0, (now - completed).total_seconds())
        if row.status == "running":
            started = _utc(row.last_started_at) if row.last_started_at else completed
            status = "running" if (now - started).total_seconds() <= settings.NODE_STALE_SECONDS else "stale"
        elif age > settings.NODE_STALE_SECONDS:
            status = "stale"
        else:
            status = row.status
        return {
            "status": status,
            "last_started_at": row.last_started_at.isoformat() if row.last_started_at else None,
            "last_completed_at": row.last_completed_at.isoformat(),
            "error_code": row.error_code,
        }
    
    
