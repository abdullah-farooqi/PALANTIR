      COLLECTOR_IMAGE="$(awk -F= '$1 == "PALANTIR_COLLECTOR_IMAGE" { sub(/^[^=]*=/, ""); print; exit }' "$SECRETS_FILE")"
    fi
    
    prompt_value() {
      local label="$1" default="$2" response
      if [[ -n "$default" ]]; then
        read -r -p "${label} [${default}]: " response </dev/tty || die "Could not read ${label}."
        printf '%s' "${response:-$default}"
