    #!/usr/bin/env bash
    # Configure and start the Netdata + PALANTIR host collector on a remote Linux host.
    set -Eeuo pipefail
    set +x
    
    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
    INSTALL_DIR="${PALANTIR_AGENT_DIR:-/opt/palantir-agent}"
    SECRETS_FILE=""
    CA_CERT=""
    NODE_IP=""
    NODE_NAME=""
