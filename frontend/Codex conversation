      echo ""
    fi
    
    echo -e "Target Server:    ${GREEN}${SERVER_URL}${NC}"
    echo -e "Node Hostname:    ${GREEN}${NODE_HOSTNAME}${NC}"
    echo -e "Advertised IP:    ${GREEN}${NODE_IP}${NC}"
    echo -e "Sensor Port:      ${GREEN}${PORT}${NC}"
