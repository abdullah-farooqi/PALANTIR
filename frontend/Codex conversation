                    or parsed.username is not None
                    or parsed.password is not None
                    or parsed.path
                    or parsed.query
                    or parsed.fragment
                    or not valid_port
                ):
                    raise ValueError(f"Invalid CORS origin: {origin}")
            return ",".join(origins)
    
