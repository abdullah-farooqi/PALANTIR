        66                    try:
        67                        value = float(candidate)
        68                    except (TypeError, ValueError):
        69                        continue
        70                    if not math.isfinite(value) or value <= 0:
        71                        continue
        72                    value_mb = value / (1024 * 1024) if value > 1024 * 1024 else value
        73                    self._ram_total_mb = round(value_mb, 2)
