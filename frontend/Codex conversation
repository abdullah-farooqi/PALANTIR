    def _worker_status(row: ServiceHeartbeat | None, now: datetime) -> dict:
        if row is None:
            return {"status": "unknown", "last_started_at": None, "last_completed_at": None, "error_code": None}
        if row.status == "running":
            started = _utc(row.last_started_at) if row.last_started_at else now
            status = "running" if (now - started).total_seconds() <= settings.NODE_STALE_SECONDS else "stale"
        elif row.last_completed_at is None:
            status = "unknown"
        elif (now - _utc(row.last_completed_at)).total_seconds() > settings.NODE_STALE_SECONDS:
            status = "stale"
        else:
            status = row.status
        return {
            "status": status,
            "last_started_at": row.last_started_at.isoformat() if row.last_started_at else None,
            "last_completed_at": row.last_completed_at.isoformat(),
