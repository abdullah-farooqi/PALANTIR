                    "Configured API tokens must be at least 32 characters and contain no whitespace"
                )
            return value
    
        @model_validator(mode="after")
        def validate_secrets_are_distinct(self):
            configured = [
                token
                for token in (
                    self.PALANTIR_WEBHOOK_SECRET,
                    self.PALANTIR_API_READ_TOKEN,
                    self.PALANTIR_API_ADMIN_TOKEN,
                    self.PALANTIR_API_ENROLL_TOKEN,
                )
                if token
            ]
            if len(configured) != len(set(configured)):
                raise ValueError("Configured webhook secret and API tokens must be distinct")
            return self
    
        @field_validator("CORS_ALLOWED_ORIGINS")
        @classmethod
        def validate_cors_origins(cls, value: str) -> str:
            origins = [origin.strip().rstrip("/") for origin in value.split(",") if origin.strip()]
            if "*" in origins:
                raise ValueError("CORS_ALLOWED_ORIGINS must list explicit origins, not '*'")
            for origin in origins:
                parsed = urlsplit(origin)
                try:
                    valid_port = parsed.port is None or 1 <= parsed.port <= 65535
                except ValueError:
                    valid_port = False
                if (
                    parsed.scheme not in {"http", "https"}
                    or not parsed.hostname
                    or parsed.username is not None
                    or parsed.password is not None
                    or parsed.path
                    or parsed.query
                    or parsed.fragment
                    or not valid_port
                ):
                    raise ValueError(f"Invalid CORS origin: {origin}")
            return ",".join(origins)
    
        @property
        def cors_origins(self) -> list[str]:
            return [origin for origin in self.CORS_ALLOWED_ORIGINS.split(",") if origin]
    
