# ─────────────────────────────────────────────────────────────────────────────
# PALANTIR Central Master Server — Environment Configuration Template
# Copy this file to '.env' and provide your custom secrets.
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# 1. DATABASE & CACHE INFRASTRUCTURE
# =============================================================================
POSTGRES_USER=palantir
POSTGRES_PASSWORD=
POSTGRES_DB=palantir

# Compose builds these database URLs from POSTGRES_USER & POSTGRES_PASSWORD.
# (If running backend or workers outside Docker, update host/port accordingly)
DATABASE_URL=postgresql+asyncpg://palantir:palantir@localhost:5432/palantir
SYNC_DATABASE_URL=postgresql+psycopg://palantir:palantir@localhost:5432/palantir

# Redis broker & caching URL
REDIS_URL=redis://localhost:6379/0


# =============================================================================
# 2. SECURITY & AUTHENTICATION SECRETS
# Requirements: Minimum 32 characters, no whitespace, distinct from each other.
# Generate with: openssl rand -hex 16
# =============================================================================

# Shared secret for internal webhooks
PALANTIR_WEBHOOK_SECRET=

# Server-side Bearer tokens injected by Caddy reverse proxy per Authentik role
PALANTIR_API_READ_TOKEN=
PALANTIR_API_ADMIN_TOKEN=

# Least-privilege token used exclusively for remote node self-enrollment
PALANTIR_API_ENROLL_TOKEN=

# Shared authentication token sent to PALANTIR host collectors
AGENT_AUTH_TOKEN=


# =============================================================================
# 3. REVERSE PROXY & CORS CONFIGURATION
# =============================================================================

# Caddy LAN interface address (127.0.0.1 keeps proxy private to loopback)
PALANTIR_LAN_BIND_IP=127.0.0.1

# Comma-separated browser origins for cross-origin API access (optional)
CORS_ALLOWED_ORIGINS=


# =============================================================================
# 4. AUTHENTIK SSO SERVICE CONFIGURATION
# =============================================================================
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.8.3
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRES_PASSWORD=


# =============================================================================
# 5. DATA RETENTION & NODE HEALTH INTERVALS
# =============================================================================
METRICS_RETENTION_HOURS=24
LOG_RETENTION_DAYS=7

# Node reachability timeouts (seconds)
NODE_REACHABLE_SECONDS=180
NODE_STALE_SECONDS=900
METRIC_STALE_SECONDS=180
WORKER_HEARTBEAT_STALE_SECONDS=180


# =============================================================================
# 6. ANOMALY DETECTION ENGINE
# =============================================================================
ANOMALY_THRESHOLD=0.7
MIN_CONTEXTS_ANOMALOUS=2
COOLDOWN_MINUTES=10


# =============================================================================
# 7. LOCAL HOST COLLECTOR AUTO-REGISTRATION (OPTIONAL)
# =============================================================================
# Automatically registers a host collector running beside the master server
LOCAL_COLLECTOR_URL=
LOCAL_NODE_HOSTNAME=local-node


# =============================================================================
# 8. DOCKER IMAGE OVERRIDES (OPTIONAL)
# =============================================================================
# Pin specific release tags instead of ':latest'
# PALANTIR_BACKEND_IMAGE=abdullahahmadfarooqi/palantir-backend:latest
# PALANTIR_COLLECTOR_IMAGE=abdullahahmadfarooqi/palantir-host-collector:latest
