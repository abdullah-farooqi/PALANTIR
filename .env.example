# PALANTIR Environment Configuration

POSTGRES_USER=palantir
POSTGRES_PASSWORD=palantir
POSTGRES_DB=palantir

DATABASE_URL=postgresql+asyncpg://palantir:palantir@localhost:5432/palantir
SYNC_DATABASE_URL=postgresql+psycopg://palantir:palantir@localhost:5432/palantir
REDIS_URL=redis://localhost:6379/0

PALANTIR_WEBHOOK_SECRET=palantir-super-secret-key-change-me
NETDATA_TIMEOUT_SECONDS=5.0
