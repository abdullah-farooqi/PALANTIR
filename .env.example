# PALANTIR Environment Configuration

POSTGRES_USER=palantir
POSTGRES_PASSWORD=
POSTGRES_DB=palantir

# Compose builds these URLs from POSTGRES_PASSWORD; update them too when running the backend outside Compose.
DATABASE_URL=postgresql+asyncpg://palantir:palantir@localhost:5432/palantir
SYNC_DATABASE_URL=postgresql+psycopg://palantir:palantir@localhost:5432/palantir
REDIS_URL=redis://localhost:6379/0

# Generate each secret independently with `openssl rand -hex 32`.
PALANTIR_WEBHOOK_SECRET=
# API tokens must be distinct, at least 32 characters, and server-side. Caddy
# injects the appropriate Bearer token for each Authentik role.
PALANTIR_API_READ_TOKEN=
PALANTIR_API_ADMIN_TOKEN=
# Optional restricted token for the remote node enroller; it can only register nodes.
PALANTIR_API_ENROLL_TOKEN=
# LAN interface address for Caddy. Keep loopback until DNS/firewall are configured.
PALANTIR_LAN_BIND_IP=127.0.0.1
# Authentik uses a separate database and persistent signing key.
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.8.3
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRES_PASSWORD=
# Comma-separated explicit origins for future cross-origin clients only.
CORS_ALLOWED_ORIGINS=
NETDATA_TIMEOUT_SECONDS=5.0
AGENT_AUTH_TOKEN=
METRICS_RETENTION_HOURS=24
LOG_RETENTION_DAYS=7
NODE_REACHABLE_SECONDS=180
NODE_STALE_SECONDS=900
METRIC_STALE_SECONDS=180
WORKER_HEARTBEAT_STALE_SECONDS=180

# Optional: Override image tags when pulling from Docker Hub or GHCR
# PALANTIR_BACKEND_IMAGE=ghcr.io/<username>/palantir-backend:latest
# PALANTIR_NETDATA_IMAGE=ghcr.io/<username>/palantir-netdata:latest
# PALANTIR_COLLECTOR_IMAGE=ghcr.io/<username>/palantir-host-collector:latest
