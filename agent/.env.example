# Host collector PCAP settings. The standard host installer passes these through
# to the collector container. Capture is opt-in because snaplen can include payload.
PCAP_ENABLED=0
PCAP_INTERFACE=any
PCAP_SNAPLEN=128
PCAP_ROTATION_SECONDS=300
PCAP_MAX_FILES=3
PCAP_MAX_SIZE_MB=50
PCAP_FILTER_EXCLUDE=port 20000 or port 8000
PCAP_STORAGE_DIR=/var/lib/palantir-agent/pcap
PCAP_COMPRESSION=zstd
PCAP_SNAPSHOT_TTL_SECONDS=1800
PCAP_MAX_ACTIVE_SNAPSHOTS=3
