{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palantir.local/schemas/agent/action-error.schema.json",
  "title": "PALANTIR host agent action error detail",
  "type": "object",
  "required": ["detail"],
  "properties": {
    "detail": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
